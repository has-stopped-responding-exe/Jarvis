# NVIDIA NIM/Nemotron
NVIDIA_API_KEY=nvapi-your-key-here
JARVIS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Any other OpenAI-compatible provider (all three are required together)
# JARVIS_API_KEY=your-provider-key
# JARVIS_BASE_URL=https://provider.example/v1
# JARVIS_MODEL=provider-model-name

# Voice feedback and microphone selection
JARVIS_TTS=0
# Set this after MicYou and VB-CABLE are installed:
# JARVIS_MICROPHONE=CABLE Output

# Home Assistant (optional)
# HOME_ASSISTANT_URL=http://homeassistant.local:8123
# HOME_ASSISTANT_TOKEN=your-long-lived-access-token
